# Use a reachable HTTPS URL in production. On a physical device, localhost is the device.
EXPO_PUBLIC_WEB_URL=http://192.168.1.10:5555
EXPO_PUBLIC_API_URL=http://192.168.1.10:3211

# Public native client; same Accounts issuer/audience as web/.env, but its own
# client_id and redirect (scheme "apchats", see app.json) — register both in
# backend-LMS. Leave empty to skip the native login gate during local dev.
# Register the generated auth/callback URI in both redirect_uris and
# post_logout_redirect_uris. Expo Go uses an exp:// URI; native builds use apchats://.
EXPO_PUBLIC_OIDC_ISSUER=
EXPO_PUBLIC_OIDC_CLIENT_ID=
EXPO_PUBLIC_OIDC_AUDIENCE=

# Same Tenor key as web/.env's VITE_TENOR_API_KEY (https://developers.google.com/tenor/guides/quickstart).
# The composer's GIF tab shows "search unavailable" without it.
EXPO_PUBLIC_TENOR_API_KEY=

# Match the aps-environment entitlement of the signed build. Local Xcode builds use sandbox.
EXPO_PUBLIC_APNS_ENVIRONMENT=sandbox
