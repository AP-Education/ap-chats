# Use a reachable HTTPS URL in production. On a physical device, localhost is the device.
EXPO_PUBLIC_WEB_URL=http://192.168.1.10:5555
EXPO_PUBLIC_API_URL=http://192.168.1.10:3211

# Public native client; same Accounts issuer/audience as web/.env, but its own
# client_id and redirect (scheme "apconnect", see app.json) — register both in
# backend-LMS. Leave empty to skip the native login gate during local dev.
EXPO_PUBLIC_OIDC_ISSUER=
EXPO_PUBLIC_OIDC_CLIENT_ID=
EXPO_PUBLIC_OIDC_AUDIENCE=
