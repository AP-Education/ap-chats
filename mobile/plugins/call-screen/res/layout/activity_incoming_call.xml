<?xml version="1.0" encoding="utf-8"?>
<!-- NativeIncomingCallScreen over the lock screen; the ids are the ones IncomingCallActivity binds. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ap_call_surface"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/expo_callkit_telecom_app_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/expo_callkit_telecom_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="#A3FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:layout_width="184dp"
            android:layout_height="184dp">

            <View
                android:layout_width="184dp"
                android:layout_height="184dp"
                android:layout_gravity="center"
                android:background="@drawable/ap_call_ring" />

            <View
                android:layout_width="152dp"
                android:layout_height="152dp"
                android:layout_gravity="center"
                android:background="@drawable/ap_call_ring" />

            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:background="@drawable/expo_callkit_telecom_bg_avatar">

                <ImageView
                    android:id="@+id/expo_callkit_telecom_avatar_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/expo_callkit_telecom_avatar_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:textColor="#58D1C9"
                    android:textSize="44sp" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/expo_callkit_telecom_caller_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/expo_callkit_telecom_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#A3FFFFFF"
            android:textSize="15sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1.4" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="48dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/expo_callkit_telecom_decline_button"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/expo_callkit_telecom_bg_decline"
                    android:contentDescription="Відхилити дзвінок"
                    android:scaleType="center"
                    android:src="@drawable/expo_callkit_telecom_ic_decline" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:importantForAccessibility="no"
                    android:text="Відхилити"
                    android:textColor="#A3FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <Space
                android:layout_width="88dp"
                android:layout_height="0dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/expo_callkit_telecom_answer_button"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/expo_callkit_telecom_bg_answer"
                    android:contentDescription="Прийняти дзвінок"
                    android:scaleType="center"
                    android:src="@drawable/expo_callkit_telecom_ic_answer" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:importantForAccessibility="no"
                    android:text="Прийняти"
                    android:textColor="#A3FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
