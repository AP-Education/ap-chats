<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The call surface's ink from the first frame, before JS draws over it. -->
    <style name="Theme.CallWindow" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/call_window_ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <color name="call_window_ink">#071113</color>
</resources>
