<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- expo-callkit-telecom opens the call here once it is answered: over the lock screen, in a task
         of its own, so the app's chats never are. -->
    <activity
      android:name="expo.modules.callwindow.CallActivity"
      android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|smallestScreenSize"
      android:excludeFromRecents="true"
      android:exported="false"
      android:launchMode="singleTask"
      android:screenOrientation="portrait"
      android:showWhenLocked="true"
      android:taskAffinity=""
      android:theme="@style/Theme.CallWindow"
      android:turnScreenOn="true">
      <intent-filter>
        <action android:name="expo.modules.callkittelecom.SHOW_CALL" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
    </activity>
  </application>
</manifest>
