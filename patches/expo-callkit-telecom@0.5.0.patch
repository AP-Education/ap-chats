diff --git a/android/src/main/java/expo/modules/callkittelecom/managers/CallScreen.kt b/android/src/main/java/expo/modules/callkittelecom/managers/CallScreen.kt
new file mode 100644
index 0000000000000000000000000000000000000000..5f44f47841d92ebdfea20eff0e350feabae2c521
--- /dev/null
+++ b/android/src/main/java/expo/modules/callkittelecom/managers/CallScreen.kt
@@ -0,0 +1,22 @@
+package expo.modules.callkittelecom.managers
+
+import android.content.Context
+import android.content.Intent
+
+/**
+ * Where a call is shown once it is answered or its notification tapped: the app's own call screen
+ * when it declares an activity for [ACTION_SHOW_CALL], otherwise its launch activity. A call screen
+ * of its own may show over the keyguard, so answering from the lock screen needs no unlock.
+ */
+internal object CallScreen {
+    const val ACTION_SHOW_CALL = "expo.modules.callkittelecom.SHOW_CALL"
+
+    fun declared(context: Context): Intent? {
+        val probe = Intent(ACTION_SHOW_CALL).setPackage(context.packageName)
+        val activity = context.packageManager.resolveActivity(probe, 0)?.activityInfo ?: return null
+        return Intent().setClassName(activity.packageName, activity.name)
+    }
+
+    fun intent(context: Context): Intent? =
+        declared(context) ?: context.packageManager.getLaunchIntentForPackage(context.packageName)
+}
