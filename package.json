{
  "name": "@ap-connect/api",
  "version": "0.0.0",
  "private": true,
  "description": "Командні чати й дзвінки зі спільним входом AP.",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "dev": "nest start --watch",
    "dev:web": "pnpm --filter @ap-connect/web dev",
    "build": "nest build",
    "build:web": "pnpm --filter @ap-connect/web build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"src/**/*.spec.ts\"",
    "lint": "eslint src",
    "lint:web": "pnpm --filter @ap-connect/web lint",
    "lint:mobile": "pnpm --filter @ap-connect/mobile lint",
    "quality": "pnpm lint && pnpm typecheck && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/compose.yaml up -d",
    "infra:down": "docker compose -f infra/compose.yaml down",
    "start": "node dist/main.js",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "commitlint": "commitlint --edit"
  },
  "dependencies": {
    "@nestjs/common": "12.1.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-fastify": "12.1.0",
    "fastify": "5.11.2",
    "jose": "6.2.12",
    "nestjs-pino": "5.2.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.5",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "pino-pretty": "13.1.1",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "webpack": "5.105.4"
  }
}
