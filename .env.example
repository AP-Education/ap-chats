# Local API and web. OIDC and LiveKit integration starts in the next milestone.
API_PORT=3211
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Use a separate local database; do not point at LMS data.
DATABASE_URL=postgresql://ap_connect:ap_connect@localhost:5434/ap_connect
REDIS_URL=redis://localhost:6381

# Accounts must register a dedicated Connect client and API audience before enabling sign-in.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=

# Server only. Never expose the secret through VITE_* or a WebView.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
