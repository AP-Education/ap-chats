# Local API and web. Register a dedicated Connect OIDC client in backend-LMS before sign-in.
API_PORT=3211
WEB_ORIGIN=http://localhost:5555
LOG_LEVEL=info
# Optional LMS-style logger settings.
# LOG_TRANSPORT=pretty
# LOG_TARGET_TYPE=stdout
# LOG_TARGET_DEST=./logs/ap-chats.log

# Use a separate local database; do not point at LMS data.
DATABASE_URL=postgresql://ap_chats:ap_chats@localhost:5434/ap_chats

# Must match the Accounts issuer and Connect resource audience.
OIDC_ISSUER=
OIDC_AUDIENCE=

# Server only. Never expose the secret through VITE_* or a WebView.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# Optional: wakes CallKit/Telecom for a ringing call when the mobile app is backgrounded
# or killed. Leave unset to keep ringing socket-only. Set all four APNS_* or none.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_VOIP_TOPIC=
# Set both FCM_* or neither.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# Same DigitalOcean Spaces bucket conventions as backend-LMS; use a dedicated bucket/prefix.
DIGITAL_OCEAN_SPACES_ENDPOINT=
DIGITAL_OCEAN_SPACES_ACCESS_KEY=
DIGITAL_OCEAN_SPACES_SECRET_KEY=
DIGITAL_OCEAN_SPACES_BUCKET=

# Chat attachment limits in bytes (decimal GB), independent of avatar uploads.
CHAT_UPLOAD_MAX_FILE_BYTES=1000000000
CHAT_UPLOAD_MAX_MESSAGE_BYTES=2000000000
CHAT_UPLOAD_MAX_FILES=10

# Durable push delivery: PostgreSQL outbox and BullMQ on Valkey.
PUSH_ENABLED=false
VALKEY_URL=redis://127.0.0.1:6380/0
PUSH_COALESCE_SECONDS=3
PUSH_COOLDOWN_SECONDS=30
PUSH_USER_ALERTS_PER_MINUTE=5
# Keep true on at least one API instance. Set false on HTTP-only replicas.
PUSH_WORKER_ENABLED=true
PUSH_WORKER_CONCURRENCY=8
# Optional Expo push access token when enhanced push security is enabled in EAS.
EXPO_ACCESS_TOKEN=
# Web Push: generate one persistent VAPID pair and set all three values.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
