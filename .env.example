# Local API and web. Register a dedicated Connect OIDC client in backend-LMS before sign-in.
API_PORT=3211
WEB_ORIGIN=http://localhost:5555
LOG_LEVEL=info

# Use a separate local database; do not point at LMS data.
DATABASE_URL=postgresql://ap_connect:ap_connect@localhost:5434/ap_connect

# Must match the Accounts issuer and Connect resource audience.
OIDC_ISSUER=
OIDC_AUDIENCE=

# Server only. Never expose the secret through VITE_* or a WebView.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
