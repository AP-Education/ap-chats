# Copy to web/.env.production (gitignored). Baked into the web image
# at build time — a different OIDC client or image bucket needs a rebuild,
# not just a redeploy.
# Must match production Accounts discovery and the backend vault values.
VITE_OIDC_ISSUER=https://api.ap-platform.online/accounts
# Use the client registered in production Accounts, with redirect URI
# https://chats.ap-platform.online/auth/callback.
VITE_OIDC_CLIENT_ID=ap-chats-web
VITE_OIDC_AUDIENCE=https://chats.ap-platform.online
VITE_IMAGES_URL=https://ap-connect-prod.fra1.digitaloceanspaces.com
VITE_TENOR_API_KEY=
