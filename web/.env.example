# Public SPA client; never put client secrets in VITE_* variables.
# Register this redirect URI in backend-LMS: http://localhost:5555/auth/callback
VITE_OIDC_ISSUER=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_AUDIENCE=

# Same DigitalOcean Spaces bucket the API uploads to; https://{bucket}.{endpoint}, no trailing slash.
VITE_IMAGES_URL=

# Google Tenor API key for the composer's GIF tab (https://developers.google.com/tenor/guides/quickstart).
# Public client key, same caveat as the OIDC vars above. The GIF tab shows "search unavailable" without it.
VITE_TENOR_API_KEY=
