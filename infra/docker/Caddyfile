{
	email {$ACME_EMAIL}
}

{$CHATS_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@backend path /api/* /socket.io/*
	handle @backend {
		reverse_proxy api:3211 {
			header_up X-Real-IP {remote_host}
		}
	}

	handle {
		root * /srv/web

		# Hashed bundles never change; everything else (index.html, push-sw.js, the manifest)
		# is revalidated, so a release never serves an old page that points at deleted bundles.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@mutable not path /assets/*
		header @mutable Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
