# syntax=docker/dockerfile:1
FROM node:24-alpine AS base
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY web/package.json ./web/
COPY mobile/package.json ./mobile/
RUN pnpm install --frozen-lockfile

FROM deps AS build
# Vite inlines these into the bundle at build time, so a tenant with a
# different OIDC client or image bucket needs its own image build, not just
# a different runtime env.
ARG VITE_OIDC_ISSUER
ARG VITE_OIDC_CLIENT_ID
ARG VITE_OIDC_AUDIENCE
ARG VITE_IMAGES_URL
ARG VITE_TENOR_API_KEY
ENV VITE_OIDC_ISSUER=${VITE_OIDC_ISSUER} \
    VITE_OIDC_CLIENT_ID=${VITE_OIDC_CLIENT_ID} \
    VITE_OIDC_AUDIENCE=${VITE_OIDC_AUDIENCE} \
    VITE_IMAGES_URL=${VITE_IMAGES_URL} \
    VITE_TENOR_API_KEY=${VITE_TENOR_API_KEY}
# The root .dockerignore excludes node_modules and dist, preserving installed
# dependencies while including public assets (including future push-sw.js).
COPY web ./web
RUN pnpm --filter @ap-chats/web build

FROM caddy:2-alpine AS runtime
COPY --from=build /app/web/dist /srv/web
COPY infra/docker/Caddyfile /etc/caddy/Caddyfile
EXPOSE 80 443
