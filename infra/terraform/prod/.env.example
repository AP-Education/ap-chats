# Copy to .env (gitignored) in this directory and fill in real values.
# Shared by both toolchains — loaded by the `infra:tf:*` scripts (directly)
# and the `infra:ansible:*` scripts (as ../terraform/prod/.env, since they
# run from infra/ansible/) in the repo root package.json, via dotenv-cli.
# No need to `export` anything by hand, repeat -var flags, or keep two
# separate env files in sync.
#
# All three DO credentials below are TF_VAR_* — matching backend-LMS's own
# terraform (same variable names, its CI wires them from Doppler secrets),
# not the digitalocean provider's own native env vars (DIGITALOCEAN_TOKEN /
# SPACES_ACCESS_KEY_ID). providers.tf wires them explicitly
# (`token = var.do_token`), so the native names are NOT read here — only
# the TF_VAR_* ones below are.

TF_VAR_do_token=

# Backblaze B2 application key for the ap-lms bucket (the state backend —
# see infra/terraform/tenants/backend.sample.tfbackend). Same one
# backend-LMS uses for its own tfstate, or your own scoped to this bucket.
# Not TF_VAR_* on purpose: this one's for the "s3" state backend itself,
# which predates provider config entirely and always reads these two names.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ap-connect's own DigitalOcean Spaces key (infra/README.md step 3) — a
# different credential from the two above.
TF_VAR_spaces_access_key_id=
TF_VAR_spaces_secret_access_key=

# CIDR(s) allowed to SSH in, and DO SSH key IDs/fingerprints to authorize.
# Lists go in as JSON — terraform parses TF_VAR_* the same way it parses a
# .tfvars file.
TF_VAR_allowed_ssh_cidrs=["CHANGE_ME/32"]
TF_VAR_ssh_key_ids=["CHANGE_ME"]

# Optional: join an existing shared VPC (e.g. backend-LMS's prod VPC).
# TF_VAR_vpc_id=

# --- Ansible (infra:ansible:* scripts) ---

# Path to a file containing the vault password in plain text, relative to
# infra/ansible/ (since that's where ansible-playbook actually runs from) —
# create it yourself: `echo yourpassword > infra/ansible/.vault-pass &&
# chmod 600 infra/ansible/.vault-pass`. Avoids --ask-vault-pass.
ANSIBLE_VAULT_PASSWORD_FILE=.vault-pass

# Path to the SSH private key authorized on the droplet (one of the
# ssh_key_ids above). Leave unset to fall back to ssh-agent or ssh's own
# default key discovery.
ANSIBLE_PRIVATE_KEY_FILE=~/.ssh/id_ed25519

# No env var covers a passphrase-protected key — ansible/ssh don't accept
# passphrases that way, by design. If the key above has one, load it once
# per shell session instead:
#   eval "$(ssh-agent)" && ssh-add ~/.ssh/id_ed25519
