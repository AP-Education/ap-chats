# Copy to vault.yml (gitignored) and encrypt in place:
#   ansible-vault encrypt infra/ansible/inventory/group_vars/prod/vault.yml
#
# Edit later with:
#   ansible-vault edit infra/ansible/inventory/group_vars/prod/vault.yml

ghcr_username: CHANGE_ME
ghcr_token: CHANGE_ME

postgres_password: CHANGE_ME

acme_email: ops@ap-platform.online

# Must match the Chats OIDC client registered in backend-LMS's Accounts.
oidc_issuer: https://accounts.ap-platform.online
oidc_audience: CHANGE_ME

# ap-connect's own two Spaces buckets (not shared with backend-LMS, and not
# shared with each other — attachments are public-read per object, backups
# never are, so they live in physically separate buckets rather than two
# prefixes in one). Both are created by infra/terraform/prod. These two keys
# are the exact same spaces_access_key_id / spaces_secret_access_key values
# you passed to `terraform apply` — one key pair, account-wide, used to
# provision both buckets and for the app/backup script to read and write
# objects in them.
#
# do_spaces_endpoint = `terraform output -raw spaces_region_endpoint`
#   (the bare region endpoint, NOT a bucket-qualified domain — the backup
#   script's `aws s3 cp --endpoint-url` breaks on one of those)
# do_spaces_bucket   = `terraform output -raw attachments_bucket_name`
# do_backups_bucket  = `terraform output -raw backups_bucket_name`
do_spaces_endpoint: https://fra1.digitaloceanspaces.com
do_spaces_access_key: CHANGE_ME
do_spaces_secret_key: CHANGE_ME
do_spaces_bucket: CHANGE_ME
do_backups_bucket: CHANGE_ME
