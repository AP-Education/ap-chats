services:
  postgres:
    image: postgres:16-alpine
    restart: always
    environment:
      POSTGRES_USER: "{{ postgres_user }}"
      POSTGRES_PASSWORD: "{{ postgres_password }}"
      POSTGRES_DB: "{{ postgres_db }}"
    volumes:
      - {{ data_path }}/postgres:/var/lib/postgresql/data
    networks:
      - chats
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ postgres_user }} -d {{ postgres_db }}"]
      interval: 5s
      timeout: 3s
      retries: 10

  valkey:
    image: valkey/valkey:8.1.9-alpine
    restart: always
    command:
      - valkey-server
      - --appendonly
      - 'yes'
      - --appendfsync
      - everysec
      - --maxmemory-policy
      - noeviction
    volumes:
      - {{ data_path }}/valkey:/data
    networks:
      - chats
    healthcheck:
      test: ["CMD", "valkey-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 10

  api:
    image: "{{ app_image }}"
    restart: always
    env_file:
      - ./app.env
    depends_on:
      postgres:
        condition: service_healthy
      valkey:
        condition: service_healthy
    networks:
      - chats

  web:
    image: "{{ web_image }}"
    restart: always
    environment:
      CHATS_DOMAIN: "{{ chats_domain }}"
      ACME_EMAIL: "{{ acme_email }}"
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - {{ data_path }}/caddy/data:/data
      - {{ data_path }}/caddy/config:/config
    depends_on:
      - api
    networks:
      - chats

networks:
  chats:
    driver: bridge
