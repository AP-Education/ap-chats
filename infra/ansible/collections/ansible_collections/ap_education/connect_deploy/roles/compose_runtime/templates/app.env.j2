API_PORT={{ api_port }}
WEB_ORIGIN={{ web_origin | default('https://' + chats_domain) }}
LOG_LEVEL={{ log_level }}
LOG_TRANSPORT={{ log_transport }}
LOG_TARGET_TYPE={{ log_target_type }}
{% if log_target_dest %}
LOG_TARGET_DEST={{ log_target_dest | to_json | replace('$', '$$') }}
{% endif %}

DATABASE_URL=postgresql://{{ postgres_user }}:{{ postgres_password }}@postgres:5432/{{ postgres_db }}

CHAT_UPLOAD_MAX_FILE_BYTES={{ chat_upload_max_file_bytes }}
CHAT_UPLOAD_MAX_MESSAGE_BYTES={{ chat_upload_max_message_bytes }}
CHAT_UPLOAD_MAX_FILES={{ chat_upload_max_files }}
CHAT_UPLOAD_MAX_PENDING_FILES={{ chat_upload_max_pending_files }}
CHAT_UPLOAD_MAX_PENDING_BYTES={{ chat_upload_max_pending_bytes }}

# Queued push delivery. Valkey is always required: it also holds who is reading the app.
PUSH_ENABLED={{ push_enabled | bool | lower }}
VALKEY_URL={{ valkey_url | to_json | replace('$', '$$') }}
PUSH_COALESCE_SECONDS={{ push_coalesce_seconds }}
PUSH_WORKER_ENABLED={{ push_worker_enabled | bool | lower }}
PUSH_WORKER_CONCURRENCY={{ push_worker_concurrency }}
EXPO_ACCESS_TOKEN={{ expo_access_token | to_json | replace('$', '$$') }}
WEB_PUSH_PUBLIC_KEY={{ web_push_public_key | to_json | replace('$', '$$') }}
WEB_PUSH_PRIVATE_KEY={{ web_push_private_key | to_json | replace('$', '$$') }}
WEB_PUSH_SUBJECT={{ web_push_subject | to_json | replace('$', '$$') }}

OIDC_ISSUER={{ oidc_issuer }}
OIDC_AUDIENCE={{ oidc_audience }}

LIVEKIT_URL={{ livekit_url | to_json | replace('$', '$$') }}
LIVEKIT_API_KEY={{ livekit_api_key | to_json | replace('$', '$$') }}
LIVEKIT_API_SECRET={{ livekit_api_secret | to_json | replace('$', '$$') }}

APNS_KEY_ID={{ apns_key_id }}
APNS_TEAM_ID={{ apns_team_id }}
# JSON quoting encodes real PEM newlines; Compose decodes them in double quotes.
# Escape dollars to prevent Compose interpolation inside credentials.
APNS_PRIVATE_KEY={{ apns_private_key | to_json | replace('$', '$$') }}
APNS_VOIP_TOPIC={{ apns_voip_topic }}
FCM_PROJECT_ID={{ fcm_project_id }}
# Quote the JSON string once more so its own private_key escapes survive Compose.
FCM_SERVICE_ACCOUNT_JSON={{ fcm_service_account_json | to_json | replace('$', '$$') }}

DIGITAL_OCEAN_SPACES_ENDPOINT={{ do_spaces_endpoint }}
DIGITAL_OCEAN_SPACES_ACCESS_KEY={{ do_spaces_access_key }}
DIGITAL_OCEAN_SPACES_SECRET_KEY={{ do_spaces_secret_key }}
DIGITAL_OCEAN_SPACES_BUCKET={{ do_spaces_bucket }}
