# Copy to infra/ansible/.env (gitignored) and fill in.
# Loaded by the `infra:ansible:*` scripts in the repo root package.json via
# dotenv-cli.

# Points at a file containing the vault password in plain text — create it
# yourself (e.g. `echo yourpassword > .vault-pass && chmod 600 .vault-pass`,
# path is relative to infra/ansible/, already gitignored). Avoids typing
# --ask-vault-pass on every run.
ANSIBLE_VAULT_PASSWORD_FILE=.vault-pass

# Path to the SSH private key authorized on the droplet (one of the
# ssh_key_ids passed to terraform). Leave unset to fall back to ssh-agent
# or ssh's own default key discovery.
ANSIBLE_PRIVATE_KEY_FILE=~/.ssh/id_ed25519

# No env var covers a passphrase-protected key — ansible/ssh don't accept
# passphrases that way, by design. If the key above has one, load it once
# per shell session instead:
#   eval "$(ssh-agent)" && ssh-add ~/.ssh/id_ed25519
