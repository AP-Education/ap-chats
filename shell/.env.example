# Public SPA client; never put client secrets in VITE_* variables.
# Register this redirect URI in backend-LMS: http://localhost:5556/auth/callback
VITE_OIDC_ISSUER=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_AUDIENCE=

# Same DigitalOcean Spaces bucket the API uploads to; https://{bucket}.{endpoint}, no trailing slash.
VITE_IMAGES_URL=

# Microfrontend remotes (origin without trailing slash). A remote without a URL is absent from the shell.
VITE_MFE_CHATS_URL=http://localhost:5557
VITE_MFE_DEMO_URL=http://localhost:5558
